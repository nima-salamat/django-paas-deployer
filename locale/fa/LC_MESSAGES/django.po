msgstr "کلید هویت Matrix تغییر کرده است یا اطلاعات ورود ذخیره‌شده نامعتبر است. "

msgid "A Matrix identity already exists without a local mapping; administrator reconciliation is required."
msgstr "هویت Matrix از قبل وجود دارد اما نگاشت محلی آن ثبت نشده است؛ مدیر سیستم باید آن را تطبیق دهد."

msgid "The Matrix identity could not be provisioned."
msgstr "ایجاد هویت Matrix ممکن نشد."

msgid "Device ID is invalid."
msgstr "شناسه دستگاه نامعتبر است."

msgid "This Matrix device was revoked. Create a new device to continue."
msgstr "دسترسی این دستگاه Matrix لغو شده است. برای ادامه دستگاه جدیدی بسازید."

msgid "Matrix did not create the expected device session."
msgstr "Matrix نشست دستگاه مورد انتظار را ایجاد نکرد."

msgid "A valid Matrix device session is required."
msgstr "یک نشست معتبر دستگاه Matrix الزامی است."

msgid "Matrix session is not bound to a device."
msgstr "نشست Matrix به دستگاه مشخصی متصل نیست."

msgid "This account has no provisioned Matrix identity."
msgstr "برای این حساب هنوز هویت Matrix ایجاد نشده است."

msgid "Matrix session belongs to a different account."
msgstr "نشست Matrix متعلق به حساب دیگری است."

msgid "This Matrix device is not registered or has been revoked."
msgstr "این دستگاه Matrix ثبت نشده است یا دسترسی آن لغو شده است."

msgid "Matrix returned an invalid device inventory."
msgstr "Matrix فهرست دستگاه‌های نامعتبری برگرداند."

msgid "Matrix device not found."
msgstr "دستگاه Matrix پیدا نشد."

msgid "Matrix room ID is invalid."
msgstr "شناسه اتاق Matrix نامعتبر است."

msgid "The Matrix room is not using the required end-to-end encryption algorithm."
msgstr "اتاق Matrix از الگوریتم رمزگذاری سرتاسری موردنیاز استفاده نمی‌کند."

msgid "The current Matrix device is not a joined member of this room."
msgstr "دستگاه فعلی Matrix عضو پیوستهٔ این اتاق نیست."

msgid "The encrypted room does not contain every intended participant."
msgstr "اتاق رمزگذاری‌شده شامل تمام شرکت‌کنندگان موردنظر نیست."

msgid "The encrypted room contains unapproved users outside the intended participant list."
msgstr "اتاق رمزگذاری‌شده شامل کاربران تأییدنشده‌ای خارج از فهرست شرکت‌کنندگان موردنظر است."

msgid "Secure Messenger rooms must use an invite-only Matrix join rule."
msgstr "اتاق‌های امن پیام‌رسان باید فقط با دعوت قابل ورود باشند."

msgid "Secure Messenger rooms must restrict history visibility to invited participants."
msgstr "نمایش تاریخچهٔ اتاق‌های امن پیام‌رسان باید به شرکت‌کنندگان دعوت‌شده محدود باشد."

msgid "Matrix space ID is invalid."
msgstr "شناسه فضای Matrix نامعتبر است."

msgid "The current Matrix device is not a joined member of the requested space."
msgstr "دستگاه فعلی Matrix عضو پیوستهٔ فضای درخواستی نیست."

msgid "The Matrix Space contains users outside the intended secure-group participant list."
msgstr "فضای Matrix شامل کاربرانی خارج از فهرست شرکت‌کنندگان گروه امن موردنظر است."

msgid "Secure group Spaces must use an invite-only join rule."
msgstr "فضاهای گروه امن باید فقط با دعوت قابل ورود باشند."

msgid "The parent room is not a Matrix Space."
msgstr "اتاق والد یک Matrix Space نیست."

msgid "The Matrix Space does not declare this room as a child."
msgstr "فضای Matrix این اتاق را به‌عنوان اتاق فرزند ثبت نکرده است."

msgid "The room is not properly linked to the requested Matrix space."
msgstr "این اتاق به‌درستی به فضای Matrix درخواستی متصل نشده است."


msgstr "امکان پاسخ به تیکت بسته‌شده وجود ندارد."

msgid "Message rate limit exceeded."
msgstr "تعداد پیام‌ها از حد مجاز فراتر رفته است."

msgid "Body or attachments required."
msgstr "متن پیام یا پیوست الزامی است."

msgid "Message sent"
msgstr "پیام ارسال شد."

msgid "Missing permission departments.manage"
msgstr "مجوز departments.manage وجود ندارد."

msgid "Created"
msgstr "ایجاد شد."

msgid "Not found"
msgstr "پیدا نشد."

msgid "Updated"
msgstr "به‌روزرسانی شد."

msgid "Deactivated"
msgstr "غیرفعال شد."

msgid "Department not found"
msgstr "دپارتمان پیدا نشد."

msgid "Staff user not found."
msgstr "کاربر کارمند پیدا نشد."

msgid "Membership saved"
msgstr "عضویت ذخیره شد."

msgid "Membership not found"

msgid "This conversation uses Matrix end-to-end encryption. The plaintext Messenger endpoint is disabled."
msgstr "این گفتگو از رمزگذاری سرتاسری Matrix استفاده می‌کند. مسیر پیام‌رسانی متنیِ عادی برای آن غیرفعال است."

msgid "End-to-end encrypted chats are not configured yet. No conversation was created."
msgstr "گفتگوهای رمزگذاری‌شدهٔ سرتاسری هنوز پیکربندی نشده‌اند. هیچ گفتگویی ایجاد نشد."

msgid "Unsupported conversation security_mode"
msgstr "حالت امنیتی گفتگو پشتیبانی نمی‌شود."

msgid "user_id required for private chat"
msgstr "برای گفتگوی خصوصی، user_id الزامی است."

msgid "User not found"
msgstr "کاربر پیدا نشد."

msgid "Cannot message blocked user"
msgstr "ارسال پیام به کاربر مسدودشده امکان‌پذیر نیست."

msgid "Conversation ready"
msgstr "گفتگو آماده است."

msgid "Group title required"
msgstr "عنوان گروه الزامی است."

msgid "Group created"
msgstr "گروه ایجاد شد."

msgid "Forbidden"
msgstr "دسترسی مجاز نیست."

msgid "Secure chat is not configured on this deployment."
msgstr "گفتگوی امن در این استقرار پیکربندی نشده است."

msgid "A Matrix device session is required."
msgstr "نشست دستگاه Matrix الزامی است."

msgid "Matrix session belongs to a different device."
msgstr "نشست Matrix متعلق به دستگاه دیگری است."

msgid "Could not start a secure-chat device session."
msgstr "امکان آغاز نشست دستگاه برای گفتگوی امن وجود نداشت."

msgid "Matrix device session ready"
msgstr "نشست دستگاه Matrix آماده است."

msgid "user_ids must be a list containing at most 100 users."
msgstr "user_ids باید فهرستی با حداکثر ۱۰۰ کاربر باشد."

msgid "Every user_id must be an integer."
msgstr "هر user_id باید عدد صحیح باشد."

msgid "Every user_id must be a positive integer."
msgstr "هر user_id باید عدد صحیح مثبت باشد."

msgid "One or more requested users do not exist or are inactive."
msgstr "یک یا چند کاربر درخواستی وجود ندارند یا غیرفعال هستند."

msgid "Secure chat can only be started with contacts or existing Messenger conversation participants."
msgstr "گفتگوی امن فقط با مخاطبان یا شرکت‌کنندگان گفتگوهای موجود پیام‌رسان قابل آغاز است."

msgid "A secure room cannot be created with a blocked user."
msgstr "ایجاد اتاق امن با کاربر مسدودشده امکان‌پذیر نیست."

msgid "Matrix identities could not be prepared."
msgstr "آماده‌سازی شناسه‌های Matrix انجام نشد."

msgid "Could not verify the Matrix device inventory."
msgstr "امکان بررسی فهرست دستگاه‌های Matrix وجود نداشت."

msgid "Could not revoke the Matrix device."
msgstr "امکان لغو دسترسی دستگاه Matrix وجود نداشت."

msgid "Matrix device revoked"
msgstr "دسترسی دستگاه Matrix لغو شد."

msgid "Unsupported conversation type."
msgstr "نوع گفتگو پشتیبانی نمی‌شود."

msgid "member_ids must be a list containing at most 100 users."
msgstr "member_ids باید فهرستی با حداکثر ۱۰۰ کاربر باشد."

msgid "Every member_id must be an integer."
msgstr "هر member_id باید عدد صحیح باشد."

msgid "Every member_id must be positive."
msgstr "هر member_id باید مثبت باشد."

msgid "One or more conversation members do not exist or are inactive."
msgstr "یک یا چند عضو گفتگو وجود ندارند یا غیرفعال هستند."

msgid "A secure private conversation must contain exactly two users."
msgstr "گفتگوی خصوصی امن باید دقیقاً دو کاربر داشته باشد."

msgid "A secure group title is required."
msgstr "عنوان گروه امن الزامی است."

msgid "A secure group must be linked to a Matrix Space."
msgstr "گروه امن باید به یک Matrix Space متصل باشد."

msgid "A secure private chat cannot be mapped to a group Space."
msgstr "گفتگوی خصوصی امن را نمی‌توان به یک فضای گروهی متصل کرد."

msgid "A valid Matrix room ID is required."
msgstr "شناسهٔ معتبر اتاق Matrix الزامی است."

msgid "Secure chat can only be created with contacts or existing Messenger conversation participants."
msgstr "گفتگوی امن فقط با مخاطبان یا شرکت‌کنندگان گفتگوهای موجود پیام‌رسان قابل ایجاد است."

msgid "This Matrix room is already mapped to a Messenger conversation."
msgstr "این اتاق Matrix قبلاً به یک گفتگوی پیام‌رسان متصل شده است."

msgid "Matrix identities for every intended participant must be provisioned first."
msgstr "ابتدا باید شناسهٔ Matrix تمام شرکت‌کنندگان موردنظر ایجاد شود."

msgid "This Matrix room is already mapped or the secure-room metadata is invalid."
msgstr "این اتاق Matrix قبلاً متصل شده است یا فرادادهٔ اتاق امن نامعتبر است."

msgid "Could not save the secure conversation metadata."
msgstr "ذخیرهٔ فرادادهٔ گفتگوی امن انجام نشد."

msgid "Encrypted conversation registered"
msgstr "گفتگوی رمزگذاری‌شده ثبت شد."

msgid "Conversation is closed"
msgstr "گفتگو بسته شده است."

msgid "You cannot send messages in this chat"
msgstr "شما اجازهٔ ارسال پیام در این گفتگو را ندارید."

msgid "Only admins can send messages in this group"
msgstr "فقط مدیران گروه می‌توانند در این گروه پیام بفرستند."

msgid "Already sent"
msgstr "قبلاً ارسال شده است."

msgid "Invalid scheduled_for datetime"
msgstr "تاریخ و زمان scheduled_for نامعتبر است."

msgid "scheduled_for must be in the future"
msgstr "scheduled_for باید در آینده باشد."

msgid "Message body or attachment required"
msgstr "متن پیام یا پیوست الزامی است."

msgid "You cannot send media"
msgstr "شما اجازهٔ ارسال رسانه را ندارید."

msgid "You can attach up to 10 files per message"
msgstr "برای هر پیام حداکثر می‌توانید ۱۰ فایل پیوست کنید."

msgid "No valid attachments were uploaded"
msgstr "هیچ پیوست معتبری بارگذاری نشد."

msgid "Scheduled"
msgstr "زمان‌بندی شد."

msgid "conversation_id required"
msgstr "conversation_id الزامی است."

msgid "Cannot send to target"
msgstr "ارسال پیام به مقصد امکان‌پذیر نیست."

msgid "View-once media cannot be forwarded"
msgstr "رسانه‌های یک‌بارمشاهده قابل ارسال مجدد نیستند."

msgid "Forwarded"
msgstr "ارسال مجدد شد."

msgid "emoji required"
msgstr "ایموجی الزامی است."

msgid "Only the sender can edit this message"
msgstr "فقط فرستنده می‌تواند این پیام را ویرایش کند."

msgid "Body cannot be empty"
msgstr "متن پیام نمی‌تواند خالی باشد."

msgid "Edited"
msgstr "ویرایش شد."

msgid "Deleted"
msgstr "حذف شد."

msgid "Invalid up_to_message_id"
msgstr "up_to_message_id نامعتبر است."

msgid "Read"
msgstr "خوانده شد."

msgid "Message is not scheduled"
msgstr "این پیام زمان‌بندی نشده است."

msgid "Scheduled message cancelled"
msgstr "پیام زمان‌بندی‌شده لغو شد."

msgid "Rate limit exceeded."
msgstr "تعداد درخواست‌ها از حد مجاز فراتر رفته است."

msgid "Validation failed"
msgstr "اعتبارسنجی ناموفق بود."

msgid "Ticket created"
msgstr "تیکت ایجاد شد."

msgid "Already closed."
msgstr "قبلاً بسته شده است."


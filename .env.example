# ============================================================
# Django
# ============================================================

# Django secret key
# IMPORTANT: Change this value in production.
SECRET_KEY=replace-with-a-long-random-secret

# 0 = Production
# 1 = Development
DEBUG=0


# ============================================================
# MAIN PostgreSQL DATABASE
# ============================================================

DB_NAME=passdb
DB_USER=psguser
DB_PASSWORD=replace-main-db-password

# Docker Compose service name.
# Do NOT use 127.0.0.1 inside Docker containers.
DB_HOST=db
DB_PORT=5432


# ============================================================
# DEPLOYMENT LOG PostgreSQL DATABASE
# ============================================================

# Separate database used for deployment logs.
#
# Docker Compose service:
# deployment-log-db
#
# Django database alias:
# deployment_logs

DEPLOYMENT_LOG_DB_NAME=deployment_logs
DEPLOYMENT_LOG_DB_USER=deployment_logs_user
DEPLOYMENT_LOG_DB_PASSWORD=replace-deployment-log-db-password

# Docker Compose service name.
# Do NOT use 127.0.0.1 inside Docker containers.
DEPLOYMENT_LOG_DB_HOST=deployment-log-db
DEPLOYMENT_LOG_DB_PORT=5432


# ============================================================
# Redis / Celery / Django Channels
# ============================================================

# Docker Compose Redis service.
REDIS_URL=redis://redis:6379

# Redis used by Django Channels / WebSockets.
CHANNEL_REDIS_URL=redis://redis:6379


# ============================================================
# Domains
# ============================================================

DOMAIN_NAME=example.com
DEPLOYMENT_DOMAIN=deploy.example.com
API_DOMAIN_NAME=api.example.com


# ============================================================
# Email / Resend
# ============================================================

EMAIL_ADDR=noreply@example.com

# Resend API key
# IMPORTANT: Replace this value in production.
RESEND_API_KEY=replace-with-a-valid-api-key


# ============================================================
# Docker Image Mirror
# ============================================================

# Optional Docker registry mirror.
#
# Example:
# DOCKER_MIRROR=docker.arvancloud.ir
#
# If you don't want to use a mirror, use:
# DOCKER_MIRROR=docker.io
#
# If this variable is removed completely, docker-compose
# automatically falls back to docker.io.
#
# The docker-compose file uses this variable when pulling
# PostgreSQL, Redis, Traefik, and other images.
DOCKER_MIRROR=docker.io


SEND_EMAIL_WITH_PROXY=false

EMAIL_PROXY=...

DOCKERFILE_DOCKER_MIRROR=docker.io
DOCKERFILE_PYTHON_MIRROR=https://pypi.org/simple
DOCKERFILE_LINUX_MIRROR=http://deb.debian.org/debian
CODENAME=trixie
DOCKERFILE_PYTHON_VERSION=3.10-slim-trixie
# ============================================================
# Jitsi Meet (messenger video/audio calls)
# ============================================================
# Base URL of your Jitsi server (no trailing slash).
# Examples: https://meet.jit.si  or  https://jitsi.yourdomain.com
JITSI_BASE_URL=https://meet.jit.si


# ============================================================
# Django
# ============================================================

# Django secret key
# IMPORTANT: Change this value in production.
SECRET_KEY=replace-with-a-long-random-secret

# 0 = Production
# 1 = Development
DEBUG=0


# ============================================================
# MAIN PostgreSQL DATABASE
# ============================================================

DB_NAME=passdb
DB_USER=psguser
DB_PASSWORD=replace-main-db-password

# Docker Compose service name.
# Do NOT use 127.0.0.1 inside Docker containers.
DB_HOST=db
DB_PORT=5432


# ============================================================
# DEPLOYMENT LOG PostgreSQL DATABASE
# ============================================================

# Separate database used for deployment logs.
#
# Docker Compose service:
# deployment-log-db
#
# Django database alias:
# deployment_logs

DEPLOYMENT_LOG_DB_NAME=deployment_logs
DEPLOYMENT_LOG_DB_USER=deployment_logs_user
DEPLOYMENT_LOG_DB_PASSWORD=replace-deployment-log-db-password

# Docker Compose service name.
# Do NOT use 127.0.0.1 inside Docker containers.
DEPLOYMENT_LOG_DB_HOST=deployment-log-db
DEPLOYMENT_LOG_DB_PORT=5432


# ============================================================
# Optional: reuse the existing Matrix PostgreSQL SERVER
# ============================================================
# 0 = keep Deployer's two local PostgreSQL containers (default/safe fallback)
# 1 = use the existing Matrix PostgreSQL server through scripts/compose.sh
# This creates/uses separate databases; NEVER point Deployer at the "synapse" database.
USE_MATRIX_POSTGRES=0
MATRIX_POSTGRES_HOST=synapse-postgres
MATRIX_POSTGRES_PORT=5432
MATRIX_POSTGRES_USER=paas_deployer
MATRIX_POSTGRES_PASSWORD=replace-with-a-new-random-password
MATRIX_POSTGRES_MAIN_DB=paas_deployer
MATRIX_POSTGRES_LOG_DB=paas_deployer_logs

# ============================================================
# Redis / Celery / Django Channels
# ============================================================

# Docker Compose Redis service.
REDIS_URL=redis://redis:6379
CELERY_BROKER_URL=redis://redis:6379
CELERY_RESULT_BACKEND=redis://redis:6379

# Redis used by Django Channels / WebSockets.
CHANNEL_REDIS_URL=redis://redis:6379
CELERY_BROKER_URL=redis://redis:6379
CELERY_RESULT_BACKEND=redis://redis:6379


# ============================================================
# Admin URLs (change these to your own random path segments)
# ============================================================
# Wagtail control panel. Example only — set your own random value.
WAGTAIL_ADMIN_PATH=control-7x9k2m

# Legacy Django admin. Example only — set your own random value.
DJANGO_ADMIN_PATH=django-4p8n6v


# ============================================================
# Domains
# ============================================================

DOMAIN_NAME=example.com
DEPLOYMENT_DOMAIN=deploy.example.com
API_DOMAIN_NAME=api.example.com


# ============================================================
# Optional Matrix E2EE Messenger integration
# ============================================================
# Leave these values empty to keep secure chat disabled until you configure an
# existing Synapse homeserver. This repository Compose file does not start Synapse.
# Public HTTPS Client-Server API URL. React browsers must be able to reach it.
MATRIX_HOMESERVER_URL=https://chat.matrix.echonode.website
# Exact `server_name` from the existing Synapse homeserver.yaml.
MATRIX_HOMESERVER_DOMAIN=chat.matrix.echonode.website
# Private backend-only URL; service alias from the existing Synapse Compose file.
MATRIX_HOMESERVER_INTERNAL_URL=http://synapse:8008
# Existing Docker network created by the separate Synapse Compose project.
# With the Compose file under /opt/matrix, the usual generated name is matrix_matrix.
# Verify with: docker network ls --filter name=matrix --format '{{.Name}}'
# Override this if the actual network has a different name.
MATRIX_DOCKER_NETWORK=matrix_matrix
# Access token for a dedicated Synapse administrator account; never expose it to React.
MATRIX_ADMIN_ACCESS_TOKEN=
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Back this key up securely. Rotating it without re-encrypting MatrixIdentity
# credentials disables future device-session provisioning.
MATRIX_IDENTITY_ENCRYPTION_KEY=


# ============================================================
# Email / Resend
# ============================================================

EMAIL_ADDR=noreply@example.com

# Resend API key
# IMPORTANT: Replace this value in production.
RESEND_API_KEY=replace-with-a-valid-api-key


# ============================================================
# Docker Image Mirror
# ============================================================

# Optional Docker registry mirror.
#
# Example:
# DOCKER_MIRROR=docker.arvancloud.ir
#
# If you don't want to use a mirror, use:
# DOCKER_MIRROR=docker.io
#
# If this variable is removed completely, docker-compose
# automatically falls back to docker.io.
#
# The docker-compose file uses this variable when pulling
# PostgreSQL, Redis, Traefik, and other images.
DOCKER_MIRROR=docker.io


SEND_EMAIL_WITH_PROXY=false

# ============================================================
# API rate limiting
# ============================================================
# Shared Redis-backed DRF API abuse protection.
API_GLOBAL_IP_RATE=600/min
API_GLOBAL_USER_RATE=1200/min
AUTH_IP_RATE=30/min
AUTH_ACCOUNT_RATE=10/min
API_SENSITIVE_USER_RATE=30/min


EMAIL_PROXY=...

DOCKERFILE_DOCKER_MIRROR=docker.io
DOCKERFILE_PYTHON_MIRROR=https://pypi.org/simple
DOCKERFILE_LINUX_MIRROR=http://deb.debian.org/debian
DOCKERFILE_PYTHON_VERSION=3.10-slim-trixie
# ============================================================
# Jitsi Meet (messenger video/audio calls)
# ============================================================
# Base URL of your Jitsi server (no trailing slash).
# Examples: https://meet.jit.si  or  https://jitsi.yourdomain.com
JITSI_BASE_URL=https://meet.jit.si

WAGTAIL_SITE_NAME=PaaS Control Panel
WAGTAILADMIN_BASE_URL=https://api.example.com
# Admin paths

# Server-owned deployment resource policy (never tenant-controlled)
DEPLOY_BUILD_RESOURCE_MODE=static
DEPLOY_BUILD_MAX_CPU=1.0
DEPLOY_BUILD_MAX_RAM_MB=1024
DEPLOY_BUILD_PIDS_LIMIT=2048
DEPLOY_BUILD_PARALLELISM=1
DEPLOY_BUILD_MAX_WAIT_MINUTE=5


# ============================================================
# Docker Swarm runtime
# ============================================================

# PassDeployer application workloads run as Docker Swarm services.
SWARM_ENABLED=1
SWARM_CLUSTER_NAME=default

# Leave empty for a single-node Swarm.
# REQUIRED when more than one Swarm node can schedule application tasks.
# Example: registry.example.com
SWARM_IMAGE_REGISTRY=

# Optional namespace used when publishing build images to the registry.
SWARM_IMAGE_NAMESPACE=passdeployer

# Local Docker volumes are node-local. On multi-node Swarm, pin services
# using local volumes to the manager that performed the build/deploy.
SWARM_LOCAL_VOLUME_PIN=1
# Warn in deployment logs when actual Docker volume usage reaches this
# percentage of declared logical capacity. Operator-controlled only; this
# does not create a physical filesystem quota by itself.
VOLUME_USAGE_WARNING_PERCENT=90

# Optional registry credentials. Prefer the Docker credential store when possible.
SWARM_IMAGE_REGISTRY_USERNAME=
SWARM_IMAGE_REGISTRY_PASSWORD=
